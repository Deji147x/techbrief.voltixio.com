# Copy to backend/.env.production on the VPS and fill in real values.
# Never commit the filled-in version.

# These three must also be set in the shell/.env that docker-compose.prod.yml
# reads for the postgres service (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB) —
# env_file values are NOT interpolated, so DATABASE_URL below must be written
# out literally with the same user/password/db you choose.
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@postgres:5432/techbrief
REDIS_URL=redis://redis:6379

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma2:9b

JWT_SECRET=
STRIPE_SECRET_KEY=
SENDGRID_API_KEY=

PORT=4000
CORS_ORIGIN=https://your-app.vercel.app
